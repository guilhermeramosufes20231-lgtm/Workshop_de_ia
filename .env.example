# Copie para backend/.env  (cp .env.example backend/.env) e preencha. NUNCA faça commit do .env.

# Chave da API da Anthropic (https://console.anthropic.com). Sem ela, o app funciona em modo offline (regras locais).
ANTHROPIC_API_KEY=

# Modelo usado pelo chat e pelas recomendações
ANTHROPIC_MODEL=claude-sonnet-5-5

# Origens permitidas (CORS), separadas por vírgula. Em desenvolvimento: o Vite.
CORS_ORIGINS=http://localhost:5173

# Limites (opcionais)
AI_RATE_LIMIT_PER_MIN=20
MAX_UPLOAD_BYTES=2097152
MAX_TRANSACTIONS=20000
